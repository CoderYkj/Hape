# /etc/gamebackend/backend.env - root-owned, mode 0600.
# `docker compose -f deploy/docker-compose.prod.yml` reads these through the shell,
# and the unit loads this file via EnvironmentFile.

# --- postgres container --------------------------------------------------------
POSTGRES_DB=nakama
POSTGRES_USER=nakama
POSTGRES_PASSWORD=CHANGE_ME

# --- released backend image ----------------------------------------------------
# Never rebuild on the host: this must be the tag CI pushed.
BACKEND_IMAGE=ghcr.io/CHANGE_ME/hape:CHANGE_ME

# --- backend ------------------------------------------------------------------
BACKEND_SERVICE_TOKEN=CHANGE_ME
BACKEND_JWT_KEY=CHANGE_ME
BACKEND_JWT_ISSUER=nakama
# The backend database, created once by deploy/postgres-init/01-backend.sql.
BACKEND_DATABASE_URL=postgres://gamebackend:CHANGE_ME@postgres:5432/gamebackend?sslmode=disable

# --- battle allocator ---------------------------------------------------------
BACKEND_ALLOCATOR=edgegap
BACKEND_EDGEGAP_TOKEN=CHANGE_ME
BACKEND_EDGEGAP_APP=Hape
BACKEND_EDGEGAP_VERSION=demo-app-lyra
# Placement fallback when a request carries no player IPs.
BACKEND_EDGEGAP_LATITUDE=31.23
BACKEND_EDGEGAP_LONGITUDE=121.47

# --- operations ---------------------------------------------------------------
BACKEND_RECONCILE_INTERVAL=30s
BACKEND_SESSION_STALE_AFTER=5m
LOG_LEVEL=info