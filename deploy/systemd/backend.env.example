# /etc/gamebackend/backend.env - root-owned, mode 0600.
# `docker compose -f deploy/docker-compose.prod.yml` reads these through the shell,
# and the unit loads this file via EnvironmentFile.

# --- postgres container --------------------------------------------------------
POSTGRES_DB=nakama
POSTGRES_USER=nakama
POSTGRES_PASSWORD=CHANGE_ME

# --- released backend image ----------------------------------------------------
# Never rebuild on the host: this must be the tag CI pushed.
BACKEND_IMAGE=ghcr.io/CHANGE_ME/hape:CHANGE_ME

# --- backend ------------------------------------------------------------------
# Server-to-server credentials: `name=token[:service+service]`, comma separated.
#
#   - the credential name shows up as `caller=` in request logs, which is how a rotation
#     is verified ("is anything still using the old one?");
#   - the scope is least privilege: a credential may only call the services it lists, and
#     an OMITTED scope means "no services" (fail closed), not "all of them";
#   - `*` is the explicit wildcard for operator tooling.
#
# Docs: docs/deploy.md 11.5 (rotation) and 11.5.1 (scope, observe-then-enforce); spec 0016.
#
# The bridge only exchanges identities, so it gets exactly one service:
BACKEND_SERVICE_CREDENTIALS=nakama=CHANGE_ME:account,ops=CHANGE_ME2:*
# A future split matchmaker worker would look like:
#   worker=CHANGE_ME3:matchmaking+session
#
# Rollout lever: set this to false to OBSERVE the policy (out-of-scope calls succeed and
# log "service credential out of scope (not enforced)") before it starts returning 403.
BACKEND_SERVICE_SCOPE_ENFORCE=true
# Legacy single token. Set this OR the variable above, never both (startup refuses it).
# BACKEND_SERVICE_TOKEN=CHANGE_ME
BACKEND_JWT_KEY=CHANGE_ME
BACKEND_JWT_ISSUER=nakama
# The backend database, created once by deploy/postgres-init/01-backend.sql.
BACKEND_DATABASE_URL=postgres://gamebackend:CHANGE_ME@postgres:5432/gamebackend?sslmode=disable

# --- battle allocator ---------------------------------------------------------
BACKEND_ALLOCATOR=edgegap
BACKEND_EDGEGAP_TOKEN=CHANGE_ME
BACKEND_EDGEGAP_APP=Hape
BACKEND_EDGEGAP_VERSION=demo-app-lyra
# Placement fallback when a request carries no player IPs.
BACKEND_EDGEGAP_LATITUDE=31.23
BACKEND_EDGEGAP_LONGITUDE=121.47

# --- operations ---------------------------------------------------------------
BACKEND_RECONCILE_INTERVAL=30s
BACKEND_SESSION_STALE_AFTER=5m
LOG_LEVEL=info